		displayFolder: Forecast
		lineageTag: fe8e88e1-9bce-546b-93bd-b3d596d7527c

	measure 'Improvement vs Naive %' = DIVIDE ( [Naive MAE] - [Forecast MAE], [Naive MAE] )
