table mart_forecast_backtest
	lineageTag: 6c306492-4cf6-506a-bb5c-13c05fdc439c

	measure 'Forecast MAE' = AVERAGE ( mart_forecast_backtest[model_abs_error_usd] )
		formatString: \$#,0.00
		displayFolder: Forecast
		lineageTag: bc3a60d9-46c9-5dda-b51c-fa3651f5af1e

	measure 'Naive MAE' = AVERAGE ( mart_forecast_backtest[naive_abs_error_usd] )
