table mart_platform_price_gap
	lineageTag: a78a9a87-097a-59b5-9926-3e0d4b9e769a

	measure 'Matched Days' = COUNTROWS ( mart_platform_price_gap )
		formatString: #,0
		displayFolder: Marketplaces
		lineageTag: 763bb342-c084-5aad-ad7a-41ee2786097c

	measure 'Amazon Cheaper %' = DIVIDE ( CALCULATE ( COUNTROWS ( mart_platform_price_gap ), mart_platform_price_gap[cheaper_platform] = "Amazon" ), COUNTROWS ( mart_platform_price_gap ) )
		formatString: 0.0%
		displayFolder: Marketplaces
		lineageTag: 2e90a8b2-2d41-5dc4-a605-4ec2424bbae6

	measure 'Median Gap %' = MEDIAN ( mart_platform_price_gap[gap_pct] ) / 100
		formatString: 0.00%
		displayFolder: Marketplaces
		lineageTag: 66fc44fa-1f17-5341-82ac-b7742816b056

	measure 'Avg Absolute Gap %' = AVERAGEX ( mart_platform_price_gap, ABS ( mart_platform_price_gap[gap_pct] ) ) / 100
		formatString: 0.0%
		displayFolder: Marketplaces
		lineageTag: dd168ec2-f5b2-5b20-8096-4da5355098fb

