table mart_model_scorecard
	lineageTag: cbd05d53-a867-5de4-a9ec-994902638261

	measure 'Launch Price' = AVERAGE ( mart_model_scorecard[msrp_usd] )
		formatString: \$#,0
		displayFolder: Scorecard
		lineageTag: 5d1dd6a9-f38a-52cd-bbb2-e1bbfa94f062

	measure 'Current Price' = AVERAGE ( mart_model_scorecard[current_price_usd] )
		formatString: \$#,0
		displayFolder: Scorecard
		lineageTag: 12352c09-17d0-51dd-a923-c28741a4f260

	measure 'Current Price Index' = AVERAGE ( mart_model_scorecard[current_price_index] )
		formatString: 0.0
		displayFolder: Scorecard
		lineageTag: 24bc4a31-2988-53f3-93c6-a45e1bb1511d

	measure 'Refurbished Discount %' = AVERAGE ( mart_model_scorecard[refurbished_discount_pct] ) / 100
		formatString: 0.0%
		displayFolder: Scorecard
		lineageTag: 89023426-4c7f-519d-a6b8-bd48904019b4

	measure 'Monthly Depreciation (pts)' = AVERAGE ( mart_model_scorecard[avg_monthly_depreciation_pts] )
		formatString: 0.00
		displayFolder: Scorecard
		lineageTag: 6a732f05-733a-5d43-9415-415eba28a4d6

