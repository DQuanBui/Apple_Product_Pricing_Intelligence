table fct_daily_market_prices
	lineageTag: d1a9b7ee-c964-5706-90cf-f8a14a156ad3

	measure 'Series-Days' = COUNTROWS ( fct_daily_market_prices )
		formatString: #,0
		displayFolder: Market
		lineageTag: 0f419ebb-c762-5dd6-a3e6-e4d10c729517

	measure Listings = SUM ( fct_daily_market_prices[listing_count] )
		formatString: #,0
		displayFolder: Market
		lineageTag: 8cf8af0e-afc8-5451-810a-9000dea45359

	measure 'Models Tracked' = DISTINCTCOUNT ( fct_daily_market_prices[model_name] )
		formatString: 0
		displayFolder: Market
		lineageTag: 8a8a1b3e-5e7b-5c9c-b1c0-ecf2eddbefab

	measure 'Avg Price' = AVERAGE ( fct_daily_market_prices[median_price_usd] )
		formatString: \$#,0
		displayFolder: Price
		lineageTag: c4f88277-7f40-56d4-8234-6f8c775b63fa

	measure 'Price Index' = DIVIDE ( SUM ( fct_daily_market_prices[median_price_usd] ), SUM ( fct_daily_market_prices[launch_price_usd] ) ) * 100
		formatString: 0.0
		displayFolder: Price
		lineageTag: 60a3cf72-5990-504c-ab14-3c030515df76

	measure 'Discount vs Launch %' = DIVIDE ( 100 - [Price Index], 100 )
		formatString: 0.0%
		displayFolder: Price
		lineageTag: ba52ca41-e56d-592e-8d58-e413f97afc10

	measure 'Savings vs Normal %' = AVERAGEX ( FILTER ( fct_daily_market_prices, NOT ISBLANK ( fct_daily_market_prices[baseline_price_30obs_usd] ) ), fct_daily_market_prices[savings_vs_baseline_pct] ) / 100
		formatString: 0.0%
		displayFolder: Sale events
		lineageTag: 58ad2fee-fdb0-5043-a201-91e9d9d0ddd8

	measure 'Event Savings vs Normal %' = CALCULATE ( [Savings vs Normal %], fct_daily_market_prices[is_sale_event] = 1 )
		formatString: 0.0%
		displayFolder: Sale events
		lineageTag: 714b7e82-557f-53a3-9ab1-d63e7f96f2f2

	measure 'In-Stock Share' = AVERAGE ( fct_daily_market_prices[in_stock_share] )
		formatString: 0.0%
		displayFolder: Market
		lineageTag: 493eb515-91a9-565f-b9ad-fa1e5f8dfd60

