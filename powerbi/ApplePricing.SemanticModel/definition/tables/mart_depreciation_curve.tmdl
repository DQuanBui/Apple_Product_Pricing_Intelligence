table mart_depreciation_curve
	lineageTag: c165e7e9-bb9c-5b97-b0f3-4ba55c5f1f06

	measure 'Price Index New' = CALCULATE ( AVERAGE ( mart_depreciation_curve[median_price_index] ), mart_depreciation_curve[condition] = "New", mart_depreciation_curve[models] >= 2, mart_depreciation_curve[series_days] >= 60 )
		formatString: 0.0
		displayFolder: Life cycle
		lineageTag: cdfae2cf-1975-5f18-b941-9a4a4ac41d5e

	measure 'Price Index Refurbished' = CALCULATE ( AVERAGE ( mart_depreciation_curve[median_price_index] ), mart_depreciation_curve[condition] = "Refurbished", mart_depreciation_curve[models] >= 2, mart_depreciation_curve[series_days] >= 60 )
		formatString: 0.0
		displayFolder: Life cycle
		lineageTag: 126a7038-cd84-527f-95e3-c60b88005321

