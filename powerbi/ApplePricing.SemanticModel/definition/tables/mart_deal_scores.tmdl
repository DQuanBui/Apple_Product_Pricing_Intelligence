table mart_deal_scores
	lineageTag: 2f3b2a9e-da1a-5349-99b1-8a586187c5fb

	measure 'Series Scored' = COUNTROWS ( mart_deal_scores )
		formatString: 0
		displayFolder: Deals
		lineageTag: cce2d755-cdce-5d20-b40a-b371e8e70c12

	measure 'Buy Now Series' = CALCULATE ( COUNTROWS ( mart_deal_scores ), mart_deal_scores[recommendation] = "Buy now" )
		formatString: 0
		displayFolder: Deals
		lineageTag: a6d94bc1-1be1-5273-bfd6-e2e1a6fa3f1f

	measure 'Wait Series' = CALCULATE ( COUNTROWS ( mart_deal_scores ), mart_deal_scores[recommendation] = "Wait" )
		formatString: 0
		displayFolder: Deals
		lineageTag: 4494d699-73b7-5917-a66b-1c5e748110e8

	measure 'Avg Deal Score' = AVERAGE ( mart_deal_scores[deal_score] )
		formatString: 0.0
		displayFolder: Deals
		lineageTag: 8ca740af-8a2e-55a6-bd5c-c31767546c6a

