{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadRawApplePricingObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion"],
      "Resource": "arn:aws:s3:::<bucket>/raw/apple_pricing/*"
    },
    {
      "Sid": "ListRawApplePricingPrefix",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::<bucket>",
      "Condition": {
        "StringLike": { "s3:prefix": ["raw/apple_pricing/*"] }
      }
    }
  ]
}
